{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'command -v graphify >/dev/null 2>&1 || exit 0; exec graphify hook-guard search'",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'command -v graphify >/dev/null 2>&1 || exit 0; exec graphify hook-guard read'",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/tools/graphify_demarrage.sh\"",
            "timeout": 180
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'command -v graphify >/dev/null 2>&1 || exit 0; exec graphify hook-guard compact'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
